{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infohq-command-center",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "VITE_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuaW5mb2hxLmluJA"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "infohq-command-center",
      "database_id": "65a48298-6c06-4494-af0b-71e020d68a68",
      "migrations_dir": "migrations"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "65a48298-6c06-4494-af0b-71e020d68a68"
      }
    ],
    "vars": {
      "VITE_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuaW5mb2hxLmluJA"
    }
  },
  "observability": {
    "enabled": true
  }
}