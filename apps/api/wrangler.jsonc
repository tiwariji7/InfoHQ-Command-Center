{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infohq-command-center-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "VITE_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuaW5mb2hxLmluJA"
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "infohq-command-center-dev",
      "database_id": "local-dev-db",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "infohq-command-center-files-dev"
    }
  ],
  "observability": {
    "enabled": true
  }
}
